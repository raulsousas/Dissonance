# =============================================================================
# Guilda — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# See docs/google-oauth-setup.md for instructions on obtaining OAuth credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public URL of the application (no trailing slash).
# Used for OAuth redirect URIs and CORS policy.
# Local dev: http://localhost:4000
APP_URL=http://localhost:4000

# Frontend origin (for CORS — usually the Vite dev server in local dev).
FRONTEND_URL=http://localhost:5173

# Phoenix secret key base — generate with: mix phx.gen.secret
# Must be at least 64 bytes.
SECRET_KEY_BASE=REPLACE_WITH_64_OR_MORE_RANDOM_BYTES_RUN_mix_phx.gen.secret

# Application environment: dev | test | prod
MIX_ENV=dev

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Used by the postgres Docker service directly
POSTGRES_USER=guilda
POSTGRES_PASSWORD=guilda
POSTGRES_DB=guilda_dev

# Used by the Phoenix backend to connect (points to the Docker service name in Docker Compose)
DATABASE_URL=ecto://guilda:guilda@postgres:5432/guilda_dev

# Connection pool size
POOL_SIZE=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# S3-compatible object storage
#
# Local dev: LocalStack (no login required, starts automatically with compose).
# Production: swap to real AWS S3, Cloudflare R2, or any S3-compatible service.
# See docs/deployment.md for the production swap.
# -----------------------------------------------------------------------------

# Internal endpoint used by the backend (inside the container network).
S3_ENDPOINT=http://localstack:4566

# External endpoint used to generate presigned URLs accessible from the browser.
S3_PUBLIC_ENDPOINT=http://localhost:4566

# Credentials — LocalStack accepts any non-empty value in local dev.
S3_ACCESS_KEY=guilda_local
S3_SECRET_KEY=guilda_local_secret

S3_BUCKET=guilda
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# See docs/google-oauth-setup.md for how to create these credentials.
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Must exactly match an Authorized Redirect URI in Google Cloud Console.
# Local dev: http://localhost:4000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# -----------------------------------------------------------------------------
# Access control
# -----------------------------------------------------------------------------

# Email address of the first admin user.
# On first login with this Google account, the user is promoted to admin.
FIRST_ADMIN_EMAIL=your-admin-email@gmail.com

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------

# Maximum file size in bytes (default: 26214400 = 25 MB).
MAX_UPLOAD_BYTES=26214400

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Session cookie name.
SESSION_COOKIE_NAME=_guilda_session

# Session lifetime in seconds (default: 2592000 = 30 days).
SESSION_MAX_AGE=2592000

# -----------------------------------------------------------------------------
# LiveKit (Voice & Video)
# -----------------------------------------------------------------------------

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=192.168.0.11
VITE_LIVEKIT_URL=ws://localhost:7880
