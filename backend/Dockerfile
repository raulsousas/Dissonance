# =============================================================================
# Guilda — Backend Dockerfile
# Multi-stage build: compile with full Elixir image, run with slim Alpine.
#
# Elixir 1.18.5 / OTP 27.3 — must match .tool-versions
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: dependencies (cached layer — only re-runs when mix.exs changes)
# ---------------------------------------------------------------------------
FROM hexpm/elixir:1.18.5-erlang-27.3.4.19-alpine-3.24.3 AS deps

RUN apk add --no-cache build-base git curl

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=dev

COPY mix.exs ./
# mix.lock is generated by mix deps.get on first build.
# Once generated (inside the volume), subsequent builds will be faster.

RUN mix deps.get
RUN mix deps.compile

# ---------------------------------------------------------------------------
# Stage 2: dev runtime (used by Compose for local development)
# Keeps mix and all dev tools available. Source is bind-mounted as a volume.
# ---------------------------------------------------------------------------
FROM hexpm/elixir:1.18.5-erlang-27.3.4.19-alpine-3.24.3 AS dev

RUN apk add --no-cache build-base git curl inotify-tools

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

# Copy compiled deps from deps stage for layer caching
COPY --from=deps /app/deps ./deps
COPY --from=deps /app/_build ./_build

ENV MIX_ENV=dev

# Entrypoint: runs migrations then starts the server.
# The script is bind-mounted from the host via the volume, so changes
# to entrypoint.sh are reflected without rebuilding the image.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# The source directory is bind-mounted in compose.yaml so we do not
# COPY source code here — changes are reflected immediately without rebuild.

CMD ["/entrypoint.sh"]
