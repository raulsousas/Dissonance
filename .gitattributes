# Normalize line endings to LF in the repository for all text files.
# On checkout, Windows gets CRLF (core.autocrlf) but the repo stores LF.
* text=auto eol=lf

# Shell scripts must always be LF (they run inside Linux containers)
*.sh text eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.ogg binary
*.zip binary
*.tar binary
*.gz binary
